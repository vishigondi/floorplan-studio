{
  "name": "floorplan-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify": "node scripts/final-interactive-sweep.mjs",
    "gates": "npm run lint && npm run check:fidelity && npm run check:licensing && npm run paired:smoke && npm run paired:geometry && npm run check:clip && npm run check:elevations && npm run check:code && npm run check:brief && npm run check:generation && npm run check:buildable && npm run check:kit && npm run check:panel-spec && npm run check:erection && npm run check:foundation && npm run check:sourcing && npm run check:ifc && npm run check:drift && npm run check:standards && npm run check:drawing && npm run check:lookrender && npm run build",
    "gates:live": "node scripts/run-live-gates.mjs",
    "gates:all": "npm run gates && npm run gates:live",
    "check:brief": "node scripts/check-brief.mjs",
    "check:code": "node scripts/check-code-advisory.mjs",
    "check:generation": "node scripts/check-generation.mjs",
    "check:buildable": "node scripts/check-buildable.mjs",
    "check:clip": "node scripts/check-envelope-clip.mjs",
    "check:elevations": "node scripts/check-elevations.mjs",
    "check:drawing": "node scripts/check-drawing-standards.mjs",
    "check:lookrender": "node scripts/check-lookrender.mjs",
    "lookrender:import": "node scripts/lookrender-import.mjs",
    "paired:smoke": "node scripts/check-den-seeds.mjs",
    "paired:geometry": "node scripts/check-paired-geometry.mjs",
    "paired:roof": "node scripts/import-roof-elevation.mjs",
    "bim:catalog": "node scripts/catalog-bim-components.mjs",
    "bim:sketchfab": "node scripts/sketchfab-cache-search.mjs",
    "bim:sketchfab:download": "node scripts/sketchfab-cache-download.mjs",
    "repair:prompt": "node scripts/print-brochure-repair-prompt.mjs",
    "repair:queue": "node scripts/print-brochure-repair-queue.mjs",
    "repair:gpt": "node scripts/request-brochure-repair-patch.mjs",
    "repair:loop": "node scripts/run-brochure-repair-loop.mjs",
    "repair:ingest": "node scripts/ingest-gpt-repair-response.mjs",
    "repair:apply": "node scripts/apply-brochure-repair-patch.mjs",
    "repair:evaluate": "node scripts/evaluate-brochure-repair-patch.mjs",
    "repair:doctor": "node scripts/repair-doctor.mjs",
    "archive:stale": "node scripts/archive-stale-paired-artifacts.mjs",
    "render:paired": "node scripts/regenerate-paired-renders.mjs",
    "drift:paired": "node scripts/recompute-visual-drift.mjs",
    "style:sweep": "node scripts/sweep-drawing-style.mjs",
    "style:extract": "python3 scripts/extract-drawing-style-profile.py",
    "goal:audit": "node scripts/drafted-product-audit.mjs",
    "qa:brochure": "node scripts/brochure-visual-qa.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:fidelity": "node scripts/check-den-fidelity.mjs",
    "check:licensing": "node scripts/check-licensing.mjs",
    "check:backfill": "node scripts/check-render-backfill.mjs",
    "check:visual": "node scripts/visual-sweep.mjs",
    "check:visual:quick": "node scripts/visual-sweep.mjs --only loft-showcase,gen-001,a-frame-22",
    "check:ifc": "node scripts/check-ifc.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "check:kit": "node scripts/check-kit-schedule.mjs",
    "check:panel-spec": "node scripts/check-panel-spec.mjs",
    "check:sourcing": "node scripts/check-sourcing.mjs",
    "check:erection": "node scripts/check-erection.mjs",
    "check:foundation": "node scripts/check-foundation.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@thatopen/components": "3.4.6",
    "@thatopen/fragments": "3.4.5",
    "@types/three": "^0.183.1",
    "camera-controls": "3.1.2",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.183.2",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
